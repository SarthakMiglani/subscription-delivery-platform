# Google OAuth Client ID (required for Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Local dev: leave VITE_API_URL unset — vite.config.ts proxies /api to
# http://localhost:8080 automatically.
#
# Production (Vercel): set VITE_API_URL to your deployed backend's base URL,
# e.g. https://juice-platform-backend.onrender.com/api/v1
# This is a Vite build-time variable — it must be set in the Vercel project's
# Environment Variables settings BEFORE building, not at runtime.
VITE_API_URL=

# Set to "true" to run against static mock data instead of a real backend
# (useful for frontend-only development/demos). Must be "false" in production.
VITE_MOCK=false
