# Production environment variables for docker-compose.prod.yml
#
# Copy this file to ".env" in the same directory (workspace root) and fill in
# every value. Never commit the real ".env" file — it is already covered by
# .gitignore's "*.env" / ".env" patterns; double check before committing.
#
# docker compose automatically loads a ".env" file located next to the compose
# file you invoke, so no extra flag is needed once it's populated.

# ── Domains ──────────────────────────────────────────────────────────────────
# Must be real DNS names pointing at this server's public IP before running
# the certbot bootstrap (see README.md).
APP_DOMAIN=app.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com

# ── Database ─────────────────────────────────────────────────────────────────
# Use a long, randomly generated password — this is NOT the local-dev
# juice_user/juice_password pair. Generate one with e.g.:
#   openssl rand -base64 32
POSTGRES_DB=juice_platform
POSTGRES_USER=juice_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD

# ── JWT signing secret ───────────────────────────────────────────────────────
# Must be at least 32 characters (enforced at startup — the app refuses to boot
# otherwise). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ── Google OAuth (customer sign-in) ──────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# The client ID is not a secret (it's shipped to the browser), but it must match
# the OAuth client configured for this exact production domain.
GOOGLE_CLIENT_ID=your-production-client-id.apps.googleusercontent.com
# Baked into the customer frontend build at build time (Vite env vars are
# compile-time). Should be the SAME value as GOOGLE_CLIENT_ID above.
VITE_GOOGLE_CLIENT_ID=your-production-client-id.apps.googleusercontent.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must match the HTTPS domains above.
APP_CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# ── Admin password bootstrap (optional, recommended for production) ─────────
# The database seed migration (V100) ships a default admin login
# (phone 9999999999 / password "admin123") for local testing. To set a real
# admin password on this deployment WITHOUT editing that migration, set this
# variable before first startup — it overwrites the seeded password hash on
# every app boot. Once you've confirmed the real password works, you may unset
# this variable again (the password stays as whatever it was last set to).
# Leave blank/unset to keep the seeded "admin123" password (NOT recommended
# for any environment reachable from the public internet).
ADMIN_BOOTSTRAP_PASSWORD=

# ── Optional tuning ───────────────────────────────────────────────────────────
# DB_POOL_MAX_SIZE=10
# DB_POOL_MIN_IDLE=2
# LOG_LEVEL_ROOT=INFO
# LOG_LEVEL_APP=INFO
# ENABLE_SWAGGER=false
